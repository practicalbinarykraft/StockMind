# Database Configuration
# Для локальной разработки используйте локальную PostgreSQL или Neon (https://neon.tech)
DATABASE_URL=postgresql://user:password@localhost:5432/stockmind

# Security Secrets (минимум 32 символа каждый)
JWT_SECRET=your-jwt-secret-key-min-32-characters-long-for-development
SESSION_SECRET=your-session-secret-key-min-32-characters-long-for-development

# Server Configuration
PORT=5000
NODE_ENV=development

# Optional: CORS (для production)
# ALLOWED_ORIGINS=https://yourdomain.com

# Optional: API Keys (можно добавить через UI в Settings)
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key
# ELEVENLABS_API_KEY=your-elevenlabs-key
# HEYGEN_API_KEY=your-heygen-key

# Optional: Monitoring
# SENTRY_DSN=your-sentry-dsn

# Video Rendering Configuration
# REMOTION_TEMP_DIR=./.....
# REMOTION_CONCURRENCY= 2
# REMOTION_TIMEOUT=# 30 минут в миллисекундах

# R2 Storage (уже настроено)
# R2_BUCKET_NAME=your-bucket
# R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
